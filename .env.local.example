# Copia este fichero a .env.local y rellena los dos valores.
# En Supabase: Project Settings -> Data API (URL) y Project Settings -> API Keys.

# La URL del proyecto, del tipo https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# La service role key (la larga, la que pone "secret"). NUNCA la anon key:
# esta clave salta el RLS y por eso solo se usa desde el servidor.
SUPABASE_SERVICE_ROLE_KEY=
